# Copy to .env and fill in. .env is gitignored; never commit it.

# Required. From your app at https://dashboard.yoto.dev (see the README).
YOTO_CLIENT_ID=your-client-id-here

# How long the automatic sleep timer runs, in minutes.
SLEEP_MINUTES=90

# Optional: only these players (comma-separated names or device ids).
# Blank = every player on the account.
PLAYERS=

# Optional: only arm timers inside this daily window (24h clock, may wrap
# past midnight), e.g. 18:00-07:00. Blank = any time of day.
ACTIVE_HOURS=

# Your local time zone, used for ACTIVE_HOURS and log timestamps.
TZ=UTC

# 1 = log what would happen without setting any timers.
DRY_RUN=0

# Docker only: the user/group the container runs as (owner of ./data).
# Find yours with `id -u` and `id -g`.
PUID=1000
PGID=1000
